#!/bin/bash
set -e

# The Connect IQ SDK tools expect CIQ_HOME to point to the SDK installation root
#   which contains Devices/, Fonts/, and Sdks/ directories.
export CIQ_HOME="/config/workspace/project/garmin-ciq"

# Paths
SDK_VERSION="connectiq-sdk-lin-9.2.0-2026-06-09-92a1605b2"
SDK_PATH="$CIQ_HOME/Sdks/$SDK_VERSION"
DEV_KEY="/config/workspace/project/GarminEven/garmin/developer_key"

# Ensure bin directory exists
mkdir -p bin

# Execute compilation using the Connect IQ compiler
# Using jungle file only - all other options are incompatible with -f
"$SDK_PATH/bin/monkeyc" \
    -d epix2 \
    -f monkey.jungle \
    -y "$DEV_KEY" \
    -o bin/output.prg
