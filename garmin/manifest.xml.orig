<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application entry="EvenG2BridgeApp" id="12345678-1234-5678-1234-567812345678" launcherIcon="@Drawables.AppIcon" name="@Strings.AppName" type="watch-app">
        <iq:products>
            <iq:product id="epix2"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Sensor"/>
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
